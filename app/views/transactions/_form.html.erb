<div class="mx-auto max-w-[600px] p-4 md:p-8">
  <%= form_with model: transaction, local: true, class: "rounded-lg bg-zinc-900 p-6 md:p-8" do |form| %>
    <% if transaction.errors.any? %>
      <div class="mb-6 rounded border-l-4 border-rose-500 bg-rose-500/20 p-4 text-rose-300">
        <h2 class="mb-2 font-semibold"><%= pluralize(transaction.errors.count, "error") %> prohibited this transaction from being saved:</h2>
        <ul class="list-disc pl-6">
          <% transaction.errors.full_messages.each do |message| %>
            <li class="mb-1"><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-5">
      <%= form.label :description, "Description", class: "mb-2 block text-sm font-semibold text-zinc-400" %>
      <%= form.text_field :description, placeholder: "e.g., Grocery shopping", class: "w-full rounded border border-zinc-700 bg-zinc-950 px-4 py-3 text-zinc-200 outline-none transition-colors focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30" %>
    </div>

    <div class="mb-5">
      <%= form.label :amount, "Amount (R$)", class: "mb-2 block text-sm font-semibold text-zinc-400" %>
      <%= form.number_field :amount, placeholder: "100.00", step: 0.01, class: "w-full rounded border border-zinc-700 bg-zinc-950 px-4 py-3 text-zinc-200 outline-none transition-colors focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30" %>
      <small class="mt-2 block text-sm text-zinc-400">Negative for expenses, positive for income</small>
    </div>

    <div class="mb-5">
      <%= form.label :category, "Category", class: "mb-2 block text-sm font-semibold text-zinc-400" %>
      <%= form.select :category,
          ["Food", "Transport", "Entertainment", "Utilities", "Healthcare", "Shopping", "Salary", "Investment", "Other"],
          { prompt: "Select category" },
          class: "w-full rounded border border-zinc-700 bg-zinc-950 px-4 py-3 text-zinc-200 outline-none transition-colors focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30" %>
    </div>

    <div class="mb-5">
      <%= form.label :date, "Date", class: "mb-2 block text-sm font-semibold text-zinc-400" %>
      <%= form.datetime_field :date, class: "w-full rounded border border-zinc-700 bg-zinc-950 px-4 py-3 text-zinc-200 outline-none transition-colors focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30" %>
    </div>

    <div class="flex flex-wrap items-center justify-end gap-2">
      <%= form.submit class: "inline-flex cursor-pointer items-center justify-center rounded bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-indigo-500" %>
      <%= link_to "Cancel", transactions_path, class: "inline-flex items-center justify-center rounded bg-zinc-700 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-zinc-600" %>
    </div>
  <% end %>
</div>
