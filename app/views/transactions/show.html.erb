<div class="mx-auto max-w-[1000px] p-4 md:p-8">
  <div class="mb-8 flex flex-col gap-4 border-b-2 border-zinc-700 pb-6 md:flex-row md:items-start md:justify-between">
    <div>
      <h1 class="text-4xl font-bold text-white"><%= @transaction.description %></h1>
      <p class="mt-2 text-zinc-400"><%= @transaction.date&.strftime("%B %d, %Y") || "N/A" %></p>
    </div>
    <div class="flex flex-wrap items-center justify-end gap-2">
      <%= link_to "Edit", edit_transaction_path(@transaction), class: "inline-flex items-center justify-center rounded bg-zinc-700 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-zinc-600" %>
      <%= link_to "Back to Transactions", transactions_path, class: "inline-flex items-center justify-center rounded bg-zinc-700 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-zinc-600" %>
      <%= button_to "Delete", transaction_path(@transaction), method: :delete, data: { confirm: "Are you sure?" }, class: "inline-flex cursor-pointer items-center justify-center rounded bg-rose-500/20 px-4 py-2 text-sm font-semibold text-rose-300 transition-colors hover:bg-rose-600 hover:text-white" %>
    </div>
  </div>

  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    <div class="flex flex-col gap-3 rounded-lg bg-zinc-900 p-6">
      <span class="text-sm text-zinc-400">Amount</span>
      <span class="text-sm font-bold <%= @transaction.amount.negative? ? 'text-rose-300' : 'text-emerald-300' %>">
        <%= @transaction.amount.negative? ? '-' : '+' %>
        R$ <%= number_with_precision(@transaction.amount.abs, precision: 2) %>
      </span>
    </div>

    <div class="flex flex-col gap-3 rounded-lg bg-zinc-900 p-6">
      <span class="text-sm text-zinc-400">Category</span>
      <span class="inline-flex w-fit items-center whitespace-nowrap rounded bg-zinc-700 px-3 py-1 text-xs font-semibold uppercase text-zinc-300"><%= @transaction.category %></span>
    </div>

    <div class="flex flex-col gap-3 rounded-lg bg-zinc-900 p-6">
      <span class="text-sm text-zinc-400">Date</span>
      <span class="font-semibold text-white"><%= @transaction.date&.strftime("%B %d, %Y") || "N/A" %></span>
    </div>

    <div class="flex flex-col gap-3 rounded-lg bg-zinc-900 p-6">
      <span class="text-sm text-zinc-400">Transaction Type</span>
      <span class="inline-flex w-fit items-center whitespace-nowrap rounded-full px-3 py-1 text-xs font-semibold uppercase <%= @transaction.amount.negative? ? 'bg-rose-500/20 text-rose-300' : 'bg-emerald-500/20 text-emerald-300' %>">
        <%= @transaction.amount.negative? ? "Expense" : "Income" %>
      </span>
    </div>
  </div>
</div>
