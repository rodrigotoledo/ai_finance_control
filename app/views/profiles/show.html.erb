<div class="mx-auto max-w-2xl p-4 md:p-8">
  <div class="mb-8 flex items-center justify-between border-b-2 border-zinc-700 pb-6">
    <h1 class="text-4xl font-bold text-white">Profile</h1>
    <%= link_to "Edit", edit_profile_path, class: "inline-flex items-center justify-center rounded bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-indigo-500" %>
  </div>

  <section class="rounded-lg bg-zinc-900 p-6">
    <div class="mb-8 border-b border-zinc-700 pb-6">
      <h2 class="mb-4 font-semibold text-white">Account</h2>
      <div class="space-y-4">
        <div>
          <span class="block text-sm text-zinc-400">Email</span>
          <span class="mt-1 font-semibold text-white"><%= @user.email %></span>
        </div>
      </div>
    </div>

    <div>
      <h2 class="mb-4 font-semibold text-white">Financial Information</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-lg border border-zinc-700 bg-zinc-800 p-6">
          <span class="block text-sm text-zinc-400">Monthly Income</span>
          <span class="mt-2 text-3xl font-bold text-emerald-400">R$ <%= number_with_precision(@user.monthly_income || 0, precision: 2) %></span>
          <p class="mt-2 text-xs text-zinc-500">Used to assess goal feasibility</p>
        </div>
        <div class="rounded-lg border border-zinc-700 bg-zinc-800 p-6">
          <span class="block text-sm text-zinc-400">Current Savings</span>
          <span class="mt-2 text-3xl font-bold text-indigo-400">R$ <%= number_with_precision(@user.current_savings || 0, precision: 2) %></span>
          <p class="mt-2 text-xs text-zinc-500">Your starting capital</p>
        </div>
      </div>
    </div>
  </section>
</div>
