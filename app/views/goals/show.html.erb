<div class="mx-auto max-w-[1000px] p-4 md:p-8">
  <div class="mb-8 flex flex-col gap-4 border-b-2 border-zinc-700 pb-6 md:flex-row md:items-start md:justify-between">
    <div>
      <h1 class="text-4xl font-bold text-white"><%= @goal.name %></h1>
      <p class="mt-2 text-zinc-400"><%= @goal.target_date.strftime("%B %d, %Y") %></p>
      <% if @goal.plan.present? %>
        <span class="mt-2 inline-flex items-center whitespace-nowrap rounded-full bg-emerald-600 px-3 py-1 text-xs font-semibold uppercase text-white">Plan Created</span>
      <% else %>
        <span class="mt-2 inline-flex items-center whitespace-nowrap rounded-full bg-indigo-600 px-3 py-1 text-xs font-semibold uppercase text-white">Awaiting Plan</span>
      <% end %>
    </div>
    <div class="flex flex-wrap items-center justify-end gap-2">
      <% if @goal.plan.blank? %>
        <%= button_to "Create Plan with AI", create_plan_goal_path(@goal), method: :post, class: "inline-flex cursor-pointer items-center justify-center rounded bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-indigo-500" %>
      <% end %>
      <%= link_to "Edit", edit_goal_path(@goal), class: "inline-flex items-center justify-center rounded bg-zinc-700 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-zinc-600" %>
      <%= link_to "Back to Goals", goals_path, class: "inline-flex items-center justify-center rounded bg-zinc-700 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-zinc-600" %>
      <%= button_to "Delete", goal_path(@goal), method: :delete, data: { confirm: "Are you sure?" }, class: "inline-flex cursor-pointer items-center justify-center rounded bg-rose-500/20 px-4 py-2 text-sm font-semibold text-rose-300 transition-colors hover:bg-rose-600 hover:text-white" %>
    </div>
  </div>

  <section class="mb-6 rounded-lg bg-zinc-900 p-6">
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3 border-b border-zinc-700 pb-3">
      <h2 class="font-semibold text-white">Current State</h2>
      <span class="text-sm text-zinc-400">Where you are now</span>
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <div class="flex flex-col gap-2 rounded-lg border border-zinc-700 bg-zinc-900 p-6"><span class="text-sm text-zinc-400">Your Savings</span><span class="font-semibold text-white">R$ <%= number_with_precision(current_user.current_savings, precision: 2) %></span></div>
      <div class="flex flex-col gap-2 rounded-lg border border-zinc-700 bg-zinc-900 p-6"><span class="text-sm text-zinc-400">Monthly Income</span><span class="font-semibold text-white">R$ <%= number_with_precision(current_user.monthly_income, precision: 2) %></span></div>
      <div class="flex flex-col gap-2 rounded-lg border border-zinc-700 bg-zinc-900 p-6"><span class="text-sm text-zinc-400">Months Until Goal</span><span class="font-semibold text-white"><%= @goal.months_remaining %></span></div>
    </div>
  </section>

  <section class="mb-6 rounded-lg bg-zinc-900 p-6">
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3 border-b border-zinc-700 pb-3">
      <h2 class="font-semibold text-white">Goal State</h2>
      <span class="text-sm text-zinc-400">What you want to achieve</span>
    </div>
    <div class="rounded-lg border border-zinc-700 bg-zinc-900 p-6">
      <div class="mb-5 flex flex-col gap-1">
        <span class="text-sm text-zinc-400">Target Amount</span>
        <span class="text-3xl font-bold text-indigo-400">R$ <%= number_with_precision(@goal.target_amount, precision: 2) %></span>
      </div>
      <div class="space-y-2">
        <div class="h-3 overflow-hidden rounded-full bg-zinc-700">
          <div class="h-full rounded-full bg-emerald-500 transition-all" style="width: <%= @progress_percentage %>%"></div>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2 text-sm font-semibold text-zinc-400">
          <span>R$ <%= number_with_precision(@goal_progress_amount, precision: 2) %> accumulated</span>
          <span><%= @progress_percentage %>% Complete</span>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-6 rounded-lg bg-zinc-900 p-6">
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3 border-b border-zinc-700 pb-3">
      <h2 class="font-semibold text-white">Milestones</h2>
      <span class="inline-flex items-center whitespace-nowrap rounded-full bg-zinc-700 px-3 py-1 text-xs font-semibold uppercase text-zinc-300"><%= @milestones.count %> phases</span>
    </div>

    <% if @milestones.any? %>
      <div class="space-y-4">
        <% accumulated_planned_amount = 0 %>
        <% @milestones.each do |milestone| %>
          <% accumulated_planned_amount += milestone.target_amount.to_f %>
          <div class="rounded-lg border border-zinc-700 bg-zinc-900 p-5 transition-colors hover:border-indigo-500" data-milestone-id="<%= milestone.id %>">
            <div class="mb-5 flex flex-wrap items-center justify-between gap-3 border-b border-zinc-700 pb-3">
              <div><span class="text-sm text-zinc-400">Phase <%= milestone.order_number %></span><h3 class="font-semibold text-white"><%= milestone.phase %></h3></div>
              <span class="inline-flex items-center whitespace-nowrap rounded-full px-3 py-1 text-xs font-semibold uppercase text-white <%= milestone.status == 'completed' ? 'bg-emerald-600' : milestone.status == 'in_progress' ? 'bg-rose-600' : 'bg-indigo-600' %>"><%= (milestone.status || 'pending').capitalize %></span>
            </div>
            <div class="grid gap-4 md:grid-cols-3">
              <div class="rounded border border-zinc-700 p-4">
                <span class="block text-sm text-zinc-400">Adds to goal</span>
                <span class="font-semibold text-white">R$ <%= number_with_precision(milestone.target_amount, precision: 2) %></span>
              </div>
              <div class="rounded border border-zinc-700 p-4">
                <span class="block text-sm text-zinc-400">Already added</span>
                <span class="font-semibold text-white">R$ <%= number_with_precision(milestone.current_amount || 0, precision: 2) %></span>
              </div>
              <div class="rounded border border-zinc-700 p-4">
                <span class="block text-sm text-zinc-400">Planned total after phase</span>
                <span class="font-semibold text-white">R$ <%= number_with_precision([accumulated_planned_amount, @goal.target_amount.to_f].min, precision: 2) %></span>
              </div>
            </div>
            <% if milestone.details.present? %>
              <div class="mt-5 space-y-4 border-t border-zinc-700 pt-5">
                <% if milestone.details["description"].present? %>
                  <div>
                    <span class="block text-sm text-zinc-400">What will be accomplished</span>
                    <p class="mt-1 text-sm text-zinc-300"><%= milestone.details["description"] %></p>
                  </div>
                <% end %>
                <% if milestone.details["key_actions"].present? && milestone.details["key_actions"].any? %>
                  <div>
                    <span class="block text-sm text-zinc-400">Key actions</span>
                    <ul class="mt-2 space-y-1">
                      <% milestone.details["key_actions"].each do |action| %>
                        <li class="flex items-start gap-2 text-sm text-zinc-300">
                          <span class="mt-1 inline-block h-1.5 w-1.5 rounded-full bg-indigo-400 flex-shrink-0"></span>
                          <span><%= action %></span>
                        </li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>
                <div class="grid gap-4 md:grid-cols-2">
                  <% if milestone.details["monthly_contribution"].present? %>
                    <div class="rounded border border-zinc-700 bg-zinc-800 p-3">
                      <span class="block text-xs text-zinc-400">Monthly contribution</span>
                      <span class="font-semibold text-white">R$ <%= number_with_precision(milestone.details["monthly_contribution"], precision: 2) %></span>
                    </div>
                  <% end %>
                  <% if milestone.details["timeline"].present? %>
                    <div class="rounded border border-zinc-700 bg-zinc-800 p-3">
                      <span class="block text-xs text-zinc-400">Timeline</span>
                      <span class="font-semibold text-white"><%= milestone.details["timeline"] %></span>
                    </div>
                  <% end %>
                  <% if milestone.details["focus"].present? %>
                    <div class="rounded border border-zinc-700 bg-zinc-800 p-3">
                      <span class="block text-xs text-zinc-400">Focus area</span>
                      <span class="font-semibold text-white"><%= milestone.details["focus"] %></span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
            <div class="mt-5 flex justify-end">
              <% if milestone.pending? %>
                <% if milestone == @next_pending_milestone %>
                  <%= button_to "Execute Milestone", execute_milestone_goal_path(@goal, milestone_id: milestone.id), method: :post, class: "inline-flex cursor-pointer items-center justify-center rounded bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-indigo-500 disabled:cursor-not-allowed disabled:bg-zinc-700 disabled:text-zinc-400", data: { disable_with: "Executing..." } %>
                <% else %>
                  <span class="inline-flex items-center justify-center rounded bg-zinc-700 px-4 py-2 text-sm font-semibold text-zinc-400">Locked</span>
                <% end %>
              <% elsif milestone.in_progress? %>
                <div class="flex flex-wrap items-center justify-end gap-2">
                  <span class="inline-flex items-center justify-center rounded bg-indigo-500/20 px-4 py-2 text-sm font-semibold text-indigo-300">In Progress</span>
                  <%= button_to "Complete Milestone", complete_milestone_goal_path(@goal, milestone_id: milestone.id), method: :post, class: "inline-flex cursor-pointer items-center justify-center rounded bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-emerald-500", data: { confirm: "Mark this milestone as completed?" } %>
                </div>
              <% else %>
                <span class="inline-flex items-center justify-center rounded bg-emerald-500/20 px-4 py-2 text-sm font-semibold text-emerald-300">Completed</span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-lg bg-zinc-800 px-6 py-12 text-center text-zinc-400"><p>No milestones created yet. <%= link_to "Create a plan", new_goal_path, class: "font-semibold text-indigo-400 hover:underline" %></p></div>
    <% end %>
  </section>

  <% if @goal.plan.present? %>
    <section class="mb-6 rounded-lg bg-zinc-900 p-6">
      <div class="mb-5 flex flex-wrap items-center justify-between gap-3 border-b border-zinc-700 pb-3"><h2 class="font-semibold text-white">Detailed Plan</h2></div>
      <div class="overflow-x-auto rounded-lg border border-zinc-700 bg-zinc-900 p-5"><pre class="whitespace-pre-wrap text-sm text-zinc-200"><%= JSON.pretty_generate(@goal.plan) %></pre></div>
    </section>
  <% end %>
</div>
