<div class="mx-auto max-w-[1200px] p-4 md:p-8">
  <div class="mb-8 flex flex-col gap-4 border-b-2 border-zinc-700 pb-4 md:flex-row md:items-center md:justify-between">
    <h1 class="text-3xl font-bold text-white">Financial Goals</h1>
    <%= link_to "New Goal", new_goal_path, class: "inline-flex items-center justify-center rounded bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-indigo-500" %>
  </div>

  <% if @goals.any? %>
    <div class="grid gap-6 [grid-template-columns:repeat(auto-fill,minmax(320px,1fr))]">
      <% @goals.each do |goal| %>
        <div class="overflow-hidden rounded-lg bg-zinc-900 transition hover:-translate-y-1 hover:shadow-xl hover:shadow-black/30">
          <div class="flex items-start justify-between gap-4 border-b border-zinc-950 bg-zinc-950 p-5">
            <h2 class="text-xl font-semibold text-white"><%= goal.name %></h2>
            <span class="inline-flex items-center whitespace-nowrap rounded-full px-3 py-1 text-xs font-semibold uppercase text-white <%= goal.status == 'completed' ? 'bg-emerald-600' : goal.status == 'in_progress' ? 'bg-rose-600' : 'bg-indigo-600' %>">
              <%= goal.status.capitalize %>
            </span>
          </div>

          <div class="p-6">
            <div class="flex items-center justify-between gap-4 border-b border-zinc-700 py-3">
              <span class="text-sm text-zinc-400">Target Amount</span>
              <span class="font-semibold text-white">R$ <%= number_with_precision(goal.target_amount, precision: 2) %></span>
            </div>

            <div class="flex items-center justify-between gap-4 border-b border-zinc-700 py-3">
              <span class="text-sm text-zinc-400">Deadline</span>
              <span class="font-semibold text-white"><%= goal.target_date.strftime("%b %d, %Y") %></span>
            </div>

            <div class="flex items-center justify-between gap-4 py-3">
              <span class="text-sm text-zinc-400">Milestones</span>
              <span class="font-semibold text-white"><%= goal.milestones.count %></span>
            </div>
          </div>

          <div class="border-t border-zinc-700 px-6 py-4">
            <div class="flex flex-wrap items-center justify-end gap-2">
              <%= link_to "View", goal_path(goal), class: "inline-flex items-center justify-center rounded bg-zinc-700 px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-zinc-600" %>
              <%= link_to "Edit", edit_goal_path(goal), class: "inline-flex items-center justify-center rounded bg-zinc-700 px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-zinc-600" %>
              <%= button_to "Delete", goal_path(goal), method: :delete, data: { confirm: "Are you sure?" }, class: "inline-flex cursor-pointer items-center justify-center rounded bg-rose-500/20 px-3 py-1.5 text-xs font-semibold text-rose-300 transition-colors hover:bg-rose-600 hover:text-white" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-lg bg-zinc-900 px-6 py-12 text-center text-zinc-400">
      <p>No financial goals yet. <%= link_to "Create one", new_goal_path, class: "font-semibold text-indigo-400 hover:underline" %></p>
    </div>
  <% end %>
</div>
