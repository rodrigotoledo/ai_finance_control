# AI Finance Control - Environment Variables Template

# ============================================================================
# OpenAI Configuration
# ============================================================================
# Get your API key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-actual-api-key-here

# ============================================================================
# Rails Configuration
# ============================================================================
RAILS_ENV=development
RAILS_LOG_LEVEL=debug

# Generate with: rails secret
RAILS_MASTER_KEY=your-master-key-here

# ============================================================================
# Database Configuration
# ============================================================================
# Optional: PostgreSQL connection string
# If not set, uses default: postgresql://localhost/ai_finance_control_development
DATABASE_URL=postgresql://username:password@localhost:5432/ai_finance_control_development

# ============================================================================
# Email Configuration (SMTP)
# ============================================================================
# Gmail example:
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Or Sendgrid:
# SENDGRID_API_KEY=sg_...

# ============================================================================
# Devise Configuration (Authentication)
# ============================================================================
# Email sender address
DEVISE_MAILER_FROM=noreply@yourapp.com

# ============================================================================
# Solid Queue Configuration (Background Jobs)
# ============================================================================
# Optional: customize job processing
# SOLID_QUEUE_PROCESSES=1
# SOLID_QUEUE_THREADS=5

# ============================================================================
# Application Configuration
# ============================================================================
# Host for URLs in emails, etc.
HOST=localhost:3000

# Enable/disable features
ENABLE_MONITORING_AGENT=false
ENABLE_EMAIL_NOTIFICATIONS=true

# ============================================================================
# Logging & Monitoring
# ============================================================================
# Sentry (error tracking) - optional
# SENTRY_DSN=https://key@sentry.io/project-id

# New Relic (APM) - optional
# NEW_RELIC_LICENSE_KEY=...

# ============================================================================
# Development Only
# ============================================================================
# Byebug debugger
ENABLE_DEBUG=false

# Seed data on db:setup
SEED_DATA=true
